# Yalnız anahtar adları; değerler .env'de (git-ignore). Ayrıntı: docs/db-notlari.md, mimari §8.1
# MySQL konteyneri (deploy/mysql/init/01-users.sh)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_APP_PASSWORD=
MYSQL_MIGRATOR_PASSWORD=
# P13a yedek kullanıcısı ('backup'@'localhost'; >= 16 karakter). Yalnız mysql servisine verilir; server env.ts'te YOK
MYSQL_BACKUP_PASSWORD=
# Server (app kullanıcısı): mysql://app:<parola>@mysql:3306/<db>?allowPublicKeyRetrieval=true
DATABASE_URL=
# Yalnız migrate servisi (migrator kullanıcısı); server konteynerine VERİLMEZ
MIGRATE_DATABASE_URL=
# Seed (ilk Super Admin; parola >= 12 karakter, ilk girişte değiştirilir)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=
# --- Uygulama (server; apps/server/src/env.ts doğrular) — mimari §8.1 ---
# production | development | test
NODE_ENV=
# info | debug | warn | error
LOG_LEVEL=
# Dış adres, port dahil. Staging: https://remote.noktabilisim.net (host nginx -> Caddy 4451, ADR-0015) · yerel compose: https://localhost:4450
PUBLIC_BASE_URL=
# WS/CSRF Origin allowlist (virgülle). Boşsa compose PUBLIC_BASE_URL kullanır. Geçişte eski origin de eklenir (staging: https://remote.noktabilisim.net,https://185.126.217.99:4450)
ALLOWED_ORIGINS=
# sessionRef HMAC anahtarı (>= 32 karakter, üretim: openssl rand -base64 48). Boşsa süreç başına rastgele (restart sonrası eski sessionRef 404); compose zorunlu tutar
SESSION_REF_KEY=
# Güvenilen proxy CIDR'ı (tek CIDR). Yalnız yerel (compose dışı) çalıştırmada; compose caddy+web sabit adreslerini (172.30.0.2/31) verir
TRUSTED_PROXY_CIDR=
# TURN (P3, ADR-0007, mimari §8.3.1): virgüllü URL listesi. Staging: stun:185.126.217.99:3478,turn:185.126.217.99:3478?transport=udp,turn:185.126.217.99:3478?transport=tcp,turns:185.126.217.99:5349?transport=tcp
TURN_URLS=
# coturn static-auth-secret (>= 32 karakter; üretim: openssl rand -base64 32). turn:/turns: URL'si varsa zorunlu. Loglanmaz
TURN_SECRET=
# TURN credential ömrü (dk, 5..60; varsayılan 20 — oturum bitince iptal edilemediği için kısa tutulur, S-P3-6)
TURN_CRED_TTL_MIN=
# /metrics Bearer token (>= 16 karakter). Boşsa /metrics 404
METRICS_TOKEN=
# Misafir ekranındaki "Kötüye kullanımı bildir" mailto: adresi (AC-125, V13, S-P4-1). production'da boşsa bağlantı GİZLENİR
# (Super Admin e-postasına düşülmez). Staging/prod'da doldurulması önerilir (ör. abuse@<alan-adı>). Boş bırakmak
# güvenlidir (env.ts boş değeri tanımsız sayar); dolu ama geçersiz adres server'ı açtırmaz (runbook §3)
ABUSE_EMAIL=
# Windows istemcisi (P6, G-07): agent_downloads volume'undaki NoktaDestek.exe'nin SHA-256'sı (64 hex). Elle yazılmaz;
# deploy/agent/verify-and-publish.sh attestation + SHA256SUMS doğrulamasından sonra yazar. Boşsa indirme ucu 503.
AGENT_SHA256=
# Yalnız compose dışı çalıştırmada: ikilinin mutlak yolu (compose /data/downloads/NoktaDestek.exe verir). Boşsa indirme 503
AGENT_BINARY_PATH=
# --- P8b müşteri destek talebi (mimari-e9 §8, §13.4/§13.5; runbook §12) ---
# whatsapp-bildirim servis adresi (sistem düzeyi; ör. http://<whatsapp-servis>:3000). Yerleşik varsayılan YOK (G-P13b-2):
# boşsa ve Super Admin panel kaydı da yoksa kanal yapılandırılmamış = kapalı (gönderim yok, test "Servis yapılandırılmamış").
# production'da http:// + özel olmayan adres → WhatsApp kanalı kapalı başlar (fail-closed); prod için https veya özel ağ adresi (K13)
WHATSAPP_SERVICE_URL=
# whatsapp-bildirim servis anahtarı (`x-api-key`, 16–256 karakter; S-P13b-3). Yalnız WHATSAPP_SERVICE_URL ile birlikte kullanılır;
# panelde adres girilmişse panel anahtarı geçerlidir. Boş = başlık gönderilmez
WHATSAPP_SERVICE_API_KEY=
# Asgari Windows istemci sürümü (x.y.z, ör. 0.9.0). Boş = kontrol yok. Düşük sürüm 426 CLIENT_OUTDATED; güvenlik yamasında yükseltilir
MIN_AGENT_VERSION=
# --- P10 hesap güvenliği + SMTP (mimari §3.2, §8.1; runbook §14) ---
# Gizli alan (SMTP şifresi, TOTP sırrı) AES-256-GCM anahtarları: v1:<openssl rand -base64 32>[,v2:...]. production'da zorunlu.
# Rotasyon: yeni sürüm EKLENİR (v1 silinmez), yeni yazımlar en yüksek sürümle yapılır. Kaybolursa şifreli ayarlar okunamaz
APP_ENCRYPTION_KEYS=
# --- P12 logo/avatar (runbook §16) ---
# Yükleme kökü (MUTLAK yol; env.ts göreli yolu reddeder). Boşsa /data/uploads. Compose sabit verir (named volume `uploads`);
# yalnız compose dışı çalıştırmada doldurun (ör. <repo mutlak yolu>/.data/uploads; .data/ git-ignore). Server kullanıcısı
# yazabilmeli; dosyalar {tenantId|system}/{rastgele}.{png|jpg|webp}
UPLOADS_DIR=
# --- Web (apps/web) --- compose'da http://server:3001; yerelde http://localhost:3001
API_INTERNAL_URL=
# Caddy -> web paylaşılan sırrı (X-Edge-Auth; >= 32 karakter, üretim: openssl rand -base64 32). Compose (caddy+web) zorunlu tutar; web production'da yoksa müşteri sayfası hata verir. Loglanmaz
EDGE_PROXY_SECRET=
# --- Compose / Caddy (deploy/docker-compose.yml) ---
# Caddy 4450 (tls internal) site adı: staging 185.126.217.99 (alan adına geçişte de IP kalır; alan adı nginx'te), yerel localhost
SITE_HOST=
# 4450'nin dinleneceği host arayüzü. PROD: 127.0.0.1 (4450 dışarı kapalı, mimari-p13 §7.2). Boşsa 0.0.0.0 (yerel)
CADDY_BIND=
# İmaj etiketi (boşsa local); rollback için önceki etiket
IMAGE_TAG=
# Ortam adı: development | staging | production (ZORUNLU; P13b, mimari-p13 §7.6). Hiçbir konteynere verilmez, env.ts'te
# yoktur: yalnız deploy/backup/backup.sh (manifest env) ve restore.sh (ortam kilidi: --target = DEPLOY_ENV = manifest env)
# bu dosyadan okur. Boşsa yedek FAILED adım=önkoşul.
DEPLOY_ENV=
# --- coturn (deploy/turn/docker-compose.yml; ayrı compose, aynı anahtarlar) — runbook §9 ---
# coturn için de aynı TURN_SECRET kullanılır (coturn >= 32 karakter ister; üretim: openssl rand -hex 32)
# Rotasyon sırasında eski secret (geçiş bitince boşaltılır)
TURN_SECRET_PREVIOUS=
# realm: prod remote.noktabilisim.net (ADR-0018 m.3)
TURN_REALM=
# <public>/<private>: staging 185.126.217.99/192.168.25.10; NAT yoksa yalnız public IP
TURN_EXTERNAL_IP=
# Allocation başına, yön başına bant tavanı, BAYT/sn (boşsa 1000000 = 8 Mbit/s, AC-21). Bir oturum en çok 6 allocation
# açabilir (G-P13b-12). Eski 8000000 değeri 64 Mbit/s demekti (P13b ölçümü: docs/implementation.md "P13b — devops")
TURN_MAX_BPS=
# coturn bps-capacity: 0 BIRAKIN (G-P13b-1). Ayarlanırsa her allocation max-bps kadar rezerve eder; 62500000/1000000 ile
# 63. allocation reddedilir (50 oturum hedefi tutmaz). Toplam tavan host'ta: TURN_FW_RELAY_MAX_BPS
TURN_BPS_CAPACITY=
# coturn Prometheus (9641) dinleme adresi (boşsa 127.0.0.1; dışa açılmaz)
TURN_PROMETHEUS_ADDRESS=
# coturn dinleme adresleri (listening-ip; 3478/5349). auto = TURN_EXTERNAL_IP'nin özel (relay) IPv4'ü + 127.0.0.1;
# veya virgüllü IPv4 listesi (127.0.0.1 healthcheck için yoksa eklenir). Boşsa TÜM arayüzler + uyarı. Staging/prod: auto
TURN_LISTEN_IPS=
# Host toplam relay tavanı, bayt/sn (host-firewall.sh hashlimit; relay->peer ve relay->istemci yönleri ayrı). Prod 62500000
# (500 Mbit/s, paylaşımlı sunucu). Boş/0 = kapalı. Değişince: sudo ./host-firewall.sh install
TURN_FW_RELAY_MAX_BPS=
# TURN-TLS sertifika dizini (compose bağlar, cert-deploy-hook.sh yazar). Prod /etc/remote/turn-certs (git dışı, G-P13b-4);
# boşsa ./certs (staging/yerel)
TURN_CERT_DIR=
