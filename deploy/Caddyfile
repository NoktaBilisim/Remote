# Remote Support — tek TLS girişi (ADR-0002, mimari §2/§5.4/§8.2).
#   /api/*, /ws/*  -> server:3001 (REST + WebSocket sinyalizasyon)
#   diğer her şey  -> web:3000 (Next.js)
#   /health, /ready, /metrics dışarıya kapalı (mimari-api "Operasyon"): iç ağdan/healthcheck ile.
# Güvenlik başlıklarının sahibi uygulamadır (Next middleware + @fastify/helmet). Caddy yalnız
# `Server` başlığını siler ve uygulama koymadıysa temel başlıkları "?" (yoksa ekle) ile tamamlar;
# böylece başlıklar çift yazılmaz / çakışmaz.
# İki giriş, aynı yönlendirme (snippet `remote_app`):
#   1) https://{$SITE_HOST}:4450 — `tls internal` (Caddy'nin yerel CA'sı; IP ile erişim, geçiş dönemi). Bu dinleyicide
#      `trusted_proxies` YOK -> istemcinin gönderdiği XFF ezilir (G-11).
#   2) http://:4451 — host nginx'in arkası (ADR-0015, runbook §8.3): nginx 443'te Let's Encrypt ile TLS sonlandırır,
#      127.0.0.1:4451'e iletir (compose yalnız loopback'e yayımlar). Bu dinleyici yalnız docker ağ geçidinden
#      (userland-proxy, 172.30.0.128) gelen XFF'e güvenir; istemci IP'si {client_ip} ile tek değere indirgenir.
# X-Edge-Auth (S-P2-1): web'e giden her isteğe paylaşılan sır yazılır (istemcinin gönderdiği aynı ad
# başlık önce silinir). Web, XFF'i server'a yalnız bu başlık eşleşirse iletir; edge ağından web:3000'e
# doğrudan gelen istek IP taklit edemez. Sır loglanmaz (aşağıdaki filtre istemcinin gönderdiğini de siler).
{
	admin off
	# G-10 (S6 bilinen 3): hata logu (http.log.error, reverse_proxy/forward_auth 502/503 vb.) varsayılan logger'a
	# `request` nesnesiyle tam URI ve başlıkları yazar. Site `log` bloğu yalnız erişim logunu kapsar; aynı filtre
	# burada da uygulanır (sorgu dizesi, /session/<token>, /downloads/Destek-<kod>.exe, firma dosyası
	# /downloads/NoktaDestek-<label>-<ref>.exe (P8b, G-E9-8) ve .zip (P31), web talep formu /r/<ref> (P19), kimlik başlıkları).
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>uri regexp "/session/[^/?]+" "/session/***"
				request>uri regexp "/downloads/Destek-[^/?]+" "/downloads/Destek-***"
				request>uri regexp "NoktaDestek-[^/?]+" "NoktaDestek-***"
				# P19 (mimari-e11 §8c.2 m.8, S-P19-10): web talep formu /r/<ref> — firma/müşteri ref'i loglanmaz.
				request>uri regexp "/r/[^/?]+" "/r/***"
				request>headers>Sec-Websocket-Protocol delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				request>headers>Referer delete
				request>headers>X-Edge-Auth delete
			}
		}
	}
	# Staging'e IP ile bağlanılır; istemci IP adresi için SNI göndermez (RFC 6066) -> SNI'sız
	# el sıkışmada SITE_HOST sertifikası seçilir. Yoksa TLS "internal error" alert'i döner.
	default_sni {$SITE_HOST}
	# 4451 (nginx arkası): ilk eşleşen `servers` bloğu uygulanır -> adresli blok genelden ÖNCE gelir.
	# 172.30.0.128 = remote_edge ağ geçidi (Docker 29 ip_range'in ilk adresi; runbook §8). Host'tan 127.0.0.1:4451'e
	# gelen bağlantı userland-proxy üzerinden bu adresten görünür. Başka adres (edge konteynerleri) güvenilmez.
	# strict: XFF sağdan okunur, ilk güvenilmeyen adres istemcidir (nginx XFF'i zaten $remote_addr ile yeniden yazar).
	servers :4451 {
		# P13c: staging katmanı CADDY_TRUSTED_PROXIES verir (172.30.1.128/32); yoksa prod değeri (adapt çıktısı aynı).
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:172.30.0.128/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		protocols h1
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

# P6/P8b indirme: forward_auth kapısı geçtikten sonra volume'daki tek jenerik ikiliyi istenen adla sunar.
# {args[0]} = indirme adı (uzantısız). `route` içinde import edilir; sıra kapı → rewrite → başlık → dosya.
(agent_exe_file) {
	root * /srv/downloads
	rewrite * /NoktaDestek.exe
	header {
		Content-Disposition "attachment; filename=\"{args[0]}.exe\""
		Content-Type "application/octet-stream"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
	file_server
}

# P28f (mimari-p28f §4.1, §5.4, S-P28f-3): macOS istemcisi — volume'daki tek jenerik zip'i istenen adla sunar
# (`agent_exe_file` kalıbı). {args[0]} = indirme adı (uzantısız).
(agent_zip_file) {
	root * /srv/downloads
	rewrite * /NoktaDestek-macOS.zip
	header {
		Content-Disposition "attachment; filename=\"{args[0]}.zip\""
		Content-Type "application/zip"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
	file_server
}

# P28g (mimari-p28g §4.1, §4.3, S-P28g-6/12): Linux istemcisi — volume'daki tek jenerik ELF'i istenen adla, UZANTISIZ sunar
# (`agent_zip_file` kalıbı). {args[0]} = indirme adı. Last-Modified GÖNDERİLMEZ: tarayıcı dosya mtime'ını ondan alırsa kılavuzdaki
# `find -mmin -30` komutu eski tarihli dosyayı görmez (S-P28g-6 m.1); silme başlığı yanıt yazılırken uygulanır (file_server'dan sonra).
(agent_bin_file) {
	root * /srv/downloads
	rewrite * /NoktaDestek-linux
	header {
		Content-Disposition "attachment; filename=\"{args[0]}\""
		Content-Type "application/octet-stream"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Last-Modified
	}
	file_server
}

# P13c (mimari-e11 §3.1): arama motoru dışı bırakma yalnız staging'de. ROBOTS_NOINDEX ayrıştırma anında okunur
# (docker-compose.staging.yml "1" verir): robots_0 boş -> prod adapt çıktısı değişmez; 0/1 dışı değer = Caddy açılmaz.
(robots_0) {
}
(robots_1) {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}
}

# Ortak site gövdesi. XFF: `header_up X-Forwarded-For {client_ip}` -> server/web tek değer görür (G-11).
# 4450'de {client_ip} = bağlantı adresi (önceki davranışla aynı); 4451'de nginx'in yazdığı gerçek istemci adresi.
(remote_app) {

	log {
		output stdout
		# G-10 / AC-90: sorgu dizesi, oturum token'ı, firma dosyası ref'i (P8b), web form ref'i (P19), çerez ve WS subprotocol loglanmaz.
		# Subprotocol silme /ws/request'teki talep sırrını (`rs.req.*`) ve /ws/guest ticket'ını da kapsar (T31).
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>uri regexp "/session/[^/?]+" "/session/***"
				request>uri regexp "/downloads/Destek-[^/?]+" "/downloads/Destek-***"
				request>uri regexp "NoktaDestek-[^/?]+" "NoktaDestek-***"
				# P19 (mimari-e11 §8c.2 m.8, S-P19-10): web talep formu /r/<ref> — firma/müşteri ref'i loglanmaz.
				request>uri regexp "/r/[^/?]+" "/r/***"
				request>headers>Sec-Websocket-Protocol delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				request>headers>Referer delete
				request>headers>X-Edge-Auth delete
				resp_headers>Set-Cookie delete
				resp_headers>Location delete
				resp_headers>Content-Disposition delete
				resp_headers>Sec-Websocket-Protocol delete
				# 101 yanıt başlığı logda kanonik olmayan yazımla (WebSocket) görünür; iki yazım da silinir (server zaten yalnız rs.v1 seçer).
				resp_headers>Sec-WebSocket-Protocol delete
			}
		}
	}

	header {
		-Server
		-X-Powered-By
		-Via
		# mimari-p13 §7.5 / G-19: includeSubDomains (yalnız *.remote.noktabilisim.net; apex ve kardeş alanlar etkilenmez), preload YOK.
		# Değer server helmet ile aynı; uygulama koyduysa "?" dokunmaz.
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
	}
	import robots_{$ROBOTS_NOINDEX:0}

	# /internal/*: server'ın forward_auth iç ucu (S6-2) — dışarıdan erişilemez.
	@ops path /health /health/* /ready /ready/* /metrics /metrics/* /internal /internal/*
	handle @ops {
		respond 404
	}

	# P6 (AC-27, ADR-0006/0010): tek jenerik Windows istemcisi. GET /api/v1/public/agent/download?ref= yalnız PENDING
	# oturumda buraya 302 verir. Dosya adı (Destek-<8 hane>.exe) yoldan gelir; her adda içerik aynı ikili, bu yol kod
	# doğrulamaz/sızdırmaz. NoktaDestek.exe: kodsuz ad (dış gözcü agent-watch). Volume'u verify-and-publish doldurur.
	# S6-2 (G-07, T13 fail-closed): dosya sunulmadan önce server'ın iç ucu volume'daki ikilinin SHA-256'sını AGENT_SHA256
	# ile karşılaştırır (önbellekli); 2xx değilse (uyuşmazlık / dosya yok / yapılandırma yok → 503, server erişilemez →
	# 502) yanıt istemciye döner ve dosya SUNULMAZ. `route` sırayı sabitler: kapı, Content-Disposition/rewrite'tan önce.
	# Orijinal URI (koddan oluşan ad) server'a gönderilmez.
	# S-P28f-3: platform başına ayrı iç URI (/internal/agent-ready/{windows,macos,linux}); her uç yalnız kendi kapısını uygular.
	@agentExe path_regexp agentExe ^/downloads/(NoktaDestek|Destek-[0-9]{8})\.exe$
	handle @agentExe {
		route {
			forward_auth server:3001 {
				uri /internal/agent-ready/windows
				header_up X-Forwarded-Uri "/downloads/***"
			}
			import agent_exe_file {re.agentExe.1}
		}
	}
	# P28f (AC-390, AC-396): macOS zip'i. GET /api/v1/public/agent/download?ref=&os=macos yalnız PENDING oturumda buraya 302
	# verir. NoktaDestek-macOS.zip: kodsuz ad (agent-watch). Kapı MAC_AGENT_SHA256 ile; 2xx değilse dosya SUNULMAZ.
	# Log maskesi `/downloads/Destek-[^/?]+` .zip'i de kapsar (G-10).
	@agentZip path_regexp agentZip ^/downloads/(NoktaDestek-macOS|Destek-[0-9]{8})\.zip$
	handle @agentZip {
		route {
			forward_auth server:3001 {
				uri /internal/agent-ready/macos
				header_up X-Forwarded-Uri "/downloads/***"
			}
			import agent_zip_file {re.agentZip.1}
		}
	}
	# P28g (AC-403, S-P28g-12): Linux ELF'i, uzantısız. GET /api/v1/public/agent/download?ref=&os=linux yalnız PENDING oturumda buraya
	# 302 verir. NoktaDestek-linux: kodsuz ad (agent-watch). Kapı /internal/agent-ready/linux (yalnız LINUX_AGENT_SHA256); 2xx değilse
	# dosya SUNULMAZ. `handle /downloads/*` 404'ünden ÖNCE. Log maskesi `/downloads/Destek-[^/?]+` uzantısız adı da kapsar (G-10).
	@agentLinux path_regexp agentLinux ^/downloads/(NoktaDestek-linux|Destek-[0-9]{8})$
	handle @agentLinux {
		route {
			forward_auth server:3001 {
				uri /internal/agent-ready/linux
				header_up X-Forwarded-Uri "/downloads/***"
			}
			import agent_bin_file {re.agentLinux.1}
		}
	}
	# P8b (AC-130, ADR-0006 r4, G-E9-11): firma dosyası NoktaDestek-<file_label>-<tenantRef>.exe — AYNI jenerik ikili.
	# label [A-Za-z0-9]{1,20}, ref [a-z2-7]{16} (mimari-e9 §1/§3.1). Yukarıdaki P6 yolundan farkı: forward_auth'a
	# ad olduğu gibi (yalnız yol, sorgu dizesi yok) gider; server ref aktif ve label güncel file_label ise 204, değilse
	# 404 döner (keyfi adlı resmi bağlantı üretilemez), ikili kapısı ayrıca 503. Ref gizli değildir (tahmin edilemez);
	# server onu loglamaz, Caddy/nginx erişim logu /downloads/NoktaDestek-*** yazar.
	@agentExeFirm path_regexp agentExeFirm ^/downloads/(NoktaDestek-[A-Za-z0-9]{1,20}-[a-z2-7]{16})\.exe$
	handle @agentExeFirm {
		route {
			forward_auth server:3001 {
				uri /internal/agent-ready/windows
				header_up X-Forwarded-Uri "/downloads/{re.agentExeFirm.1}.exe"
			}
			import agent_exe_file {re.agentExeFirm.1}
		}
	}
	# P31 (AC-510; mimari-p31 K-P31-3, §15.1, S-P31-1): Mac firma zip'i NoktaDestek-<file_label>-<tenantRef>.zip — AYNI jenerik
	# macOS zip'i (agent_zip_file). Kapı AYRI iç uç /internal/agent-ready/macos-firm (fail-closed): ad tam firma deseni değilse ya da
	# ref pasif / label eski ise 404, mac ikili kapısı (MAC_AGENT_SHA256) değilse 503. X-Forwarded-Uri = yalnız yol, tam ad ({path}
	# sorgu dizesi içermez). @agentZip'teki `"/downloads/***"` satırı BURAYA KOPYALANMAZ (kopyalanırsa uç 404 verir — hata kapalı
	# yönde). Yayın: önce sunucu (uç canlı), sonra bu dosya; geri alma ters (runbook §32). Eski sunucuda uç yok → 404 (zip sunulmaz).
	# Log maskesi "NoktaDestek-[^/?]+" .zip firma adını da kapsar (G-10). `handle /downloads/*` 404'ünden ÖNCE.
	@agentZipFirm path_regexp agentZipFirm ^/downloads/(NoktaDestek-[A-Za-z0-9]{1,20}-[a-z2-7]{16})\.zip$
	handle @agentZipFirm {
		route {
			forward_auth server:3001 {
				uri /internal/agent-ready/macos-firm
				header_up X-Forwarded-Uri {path}
			}
			import agent_zip_file {re.agentZipFirm.1}
		}
	}
	handle /downloads/* {
		respond 404
	}

	# P12 (AC-81..84): logo/avatar yükleme uçları. Dosya sınırı 2 MB (server/@fastify/multipart uygular, 413) +
	# multipart zarfı; Caddy `2MB` = 2.000.000 bayt (SI) olduğundan tam 2 MiB'lık dosya burada kesilirdi. Bu uçlara
	# 3 MiB tavan (nginx `client_max_body_size 3m` ile aynı), diğer /api/* 2MB'ta kalır. İki matcher birbirini dışlar
	# (iki `request_body` aynı isteğe uygulanırsa küçük olan kazanır). Uç listesi mimari-api "Yönetim"; yeni yükleme
	# ucu eklenirse buraya da eklenir (test: deploy/test-caddy.sh "gövde sınırı").
	@upload {
		method POST
		path_regexp ^/api/v1/(settings/logo|admin/settings/system-logo|users/[^/]+/avatar)$
	}
	# P28e (mimari-p28e §5, §11.4): kayıt parçası PUT /api/v1/rec/<rid>/series/<s>/parts/<p> en çok REC_PART_MAX_BYTES =
	# 2097152 (2 MiB; Fastify bodyLimit ile aynı). 2MB (SI, 2.000.000) bunu keserdi -> @notUpload bu isteği DIŞLAR (iki sınırdan
	# küçüğü kazanırdı), @recPart kendi tavanını uygular. İki `not` bloğu VE'lenir. Gövde süresi read_body 30s (2 MiB / 30 sn ≈
	# 560 kbit/s yükleme; hedef bit hızı 1,5 Mbit/s bunun üstünde). Belirteç yalnız Authorization başlığında (log filtresi siler).
	@recPart {
		method PUT
		path_regexp ^/api/v1/rec/[^/]+/series/[0-9]+/parts/[0-9]+$
	}
	@notUpload {
		not {
			method POST
			path_regexp ^/api/v1/(settings/logo|admin/settings/system-logo|users/[^/]+/avatar)$
		}
		not {
			method PUT
			path_regexp ^/api/v1/rec/[^/]+/series/[0-9]+/parts/[0-9]+$
		}
	}
	# P28b (mimari-p28b §4, K-P28b-4): sunucu modu dosya parçası PUT /api/v1/fsrv/uploads/<fid>/chunks/<n> en çok 1 MiB + 1
	# (Fastify bodyLimit ile aynı). @notUpload (2MB) de bu isteğe uygulanır; iki sınırdan küçüğü geçerli. Gövde süresi
	# `servers` read_body 30s (1 MiB / 30 sn ≥ 280 kbit/s). Belirteç yalnız Authorization başlığında (log filtresi siler);
	# indirme yanıtının Content-Disposition'ı (dosya adı) da loga yazılmaz (resp_headers filtresi).
	@fsrvChunk {
		method PUT
		path_regexp ^/api/v1/fsrv/uploads/[^/]+/chunks/[0-9]+$
	}
	handle /api/* {
		request_body @upload {
			max_size 3MiB
		}
		request_body @notUpload {
			max_size 2MB
		}
		request_body @fsrvChunk {
			max_size 1048577
		}
		request_body @recPart {
			max_size 2097152
		}
		reverse_proxy server:3001 {
			header_up -X-Edge-Auth
			header_up X-Forwarded-For {client_ip}
		}
	}

	# /ws/tech, /ws/guest, P8b /ws/request (müşteri bekleme; talep sırrı subprotocol'de) ve /ws/panel (panel bildirimi,
	# çerez + Origin). Ek ayar gerekmez: Caddy yükseltilmiş (hijacked) bağlantıya okuma/boşta zaman aşımı uygulamaz
	# (`servers` timeouts yalnız HTTP aşamasında), server 30 sn'de ping atar; nginx katmanında proxy_read_timeout 3700s.
	handle /ws/* {
		reverse_proxy server:3001 {
			header_up -X-Edge-Auth
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000 {
			# Değer atamak (set) istemcinin gönderdiği aynı ad başlığı ezer; ayrıca silmek gerekmez.
			header_up X-Edge-Auth {env.EDGE_PROXY_SECRET}
			header_up X-Forwarded-For {client_ip}
		}
	}
}

https://{$SITE_HOST}:4450 {
	tls internal
	import remote_app
}

# Host nginx arkası (remote.noktabilisim.net). TLS nginx'te; Host eşleşmesi nginx server_name'de yapılır.
# Dinleyiciye yalnız host loopback'inden (compose 127.0.0.1:4451) ulaşılır. X-Forwarded-Proto/Host trusted
# proxy'den geldiği için korunur (web CSP `upgrade-insecure-requests`, wss:// host'u).
http://:4451 {
	import remote_app
}
