# Remote Support prod izleme (mimari-p13 §7.8). Kurulum: sudo deploy/ops/remote-watch.sh install (bu dosyayı
# /etc/systemd/system'e kopyalar). Betik git ağacından DEĞİL root sahipli kurulu kopyadan çalışır (G-P13b-13).
[Unit]
Description=Remote Support izleme (remote-watch)
Documentation=file:///opt/remote/docs/runbook.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/remote/remote-watch.sh run
User=root
UMask=0077
TimeoutStartSec=5min
StateDirectory=remote-watch
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SyslogIdentifier=remote-watch
