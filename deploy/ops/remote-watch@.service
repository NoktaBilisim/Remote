# Remote Support ikinci örnek izleme (P13c; mimari-e11 §3.1, runbook §21). Kurulum: sudo deploy/ops/remote-watch.sh install stg
# (şablonu /etc/systemd/system'e kopyalar, remote-watch@stg.timer etkin). Yapılandırma /etc/remote-watch/<örnek>.env.
[Unit]
Description=Remote Support izleme (remote-watch, ornek %i)
Documentation=file:///opt/remote/docs/runbook.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/remote/remote-watch.sh run %i
User=root
UMask=0077
TimeoutStartSec=5min
StateDirectory=remote-watch
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SyslogIdentifier=remote-watch-%i
