# Bağımlılıklar
node_modules/
.pnpm-store/

# Ortam / gizli bilgiler (yalnız .env.example repoya girer)
.env
.env.*
!.env.example
*.pem
*.key

# Build çıktıları
dist/
.next/
apps/web/out/
coverage/
*.tsbuildinfo
.turbo/
apps/agent-win/bin/

# Üretilen kod
apps/server/src/generated/

# Test çıktıları
playwright-report/
test-results/
blob-report/

# TURN ortam dosyaları (altyapı IP'leri, G-05)
deploy/turn/*.local.conf
# TURN-TLS staging CA + sunucu sertifikası (gen-cert.sh; özel anahtarlar asla repoya girmez)
deploy/turn/certs/

# Log / OS / editör
*.log
.DS_Store
.idea/
.vscode/

# Staging erişim dosyası (sunucuda üretilir, asla repoya girmez)
deploy/ACCESS.txt
apps/agent-win/cmd/noktadestek/rsrc_windows_*.syso
# İstemci yayın kaydı (sunucuda verify-and-publish.sh yazar)
deploy/agent/PUBLISHED.log

# P12 yerel (compose dışı) yükleme kökü: UPLOADS_DIR=./.data/uploads — kullanıcı dosyaları repoya girmez
.data/

# P13a yedek yapılandırması (sunucuda; anahtar listesi deploy/backup/backup.env.example)
deploy/backup/backup.env
# P13b izleme yapılandırması (sunucuda /etc/remote-watch/watch.env; buraya kopyalanırsa da repoya girmez)
deploy/ops/watch.env
