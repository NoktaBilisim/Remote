{
  "name": "@remote/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "test:cov": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include='src/**/*.ts'",
    "cli": "node src/cli/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma db execute --file prisma/sql/grants.sql",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remote/contracts": "workspace:*",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "file-type": "22.3.0",
    "nodemailer": "10.5.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "smtp-server": "3.21.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
