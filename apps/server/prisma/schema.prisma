// Remote Support — P1..P10 veri modeli (docs/mimari.md §3, docs/db-notlari.md).
// Kurallar: PK ULID CHAR(26) (uygulama üretir, lib/ids.ts); zaman DATETIME(3) UTC;
// enum'lar VARCHAR(20) + zod enum; FK'ler ON DELETE RESTRICT (cascade yok);
// tenant/kullanıcı soft delete (deleted_at/status); audit_logs append-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model Tenant {
  id        String    @id @db.Char(26)
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(60)
  status    String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | PASSIVE
  logoPath  String?   @map("logo_path") @db.VarChar(200)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  settings        TenantSettings?
  users           User[]
  actingSessions  AuthSession[]
  auditLogs       AuditLog[]
  supportSessions SupportSession[]
  consentTexts    ConsentText[]
  sessionConsents SessionConsent[]
  sessionFiles    SessionFile[]
  requestSettings TenantRequestSettings?
  supportRequests SupportRequest[]
  customers       Customer[]
  requestRefs     RequestRef[]
  deviceBindings  DeviceBinding[]
  requestBlocks   RequestBlock[]

  @@map("tenants")
}

model TenantSettings {
  tenantId        String   @id @map("tenant_id") @db.Char(26)
  sessionTtlMin   Int      @default(15) @map("session_ttl_min") // 15..30
  maxOpenSessions Int      @default(3) @map("max_open_sessions") // 1..10
  maxActiveHours  Int      @default(4) @map("max_active_hours") // 1..8
  maxFileMb       Int      @default(100) @map("max_file_mb") // 1..2048
  requireTech2fa  Boolean  @default(true) @map("require_tech_2fa")
  retentionDays   Int      @default(365) @map("retention_days") // 90..730
  smtpHost        String?  @map("smtp_host") @db.VarChar(255)
  smtpPort        Int?     @map("smtp_port")
  smtpSecurity    String?  @map("smtp_security") @db.VarChar(20) // NONE | SSL | STARTTLS
  smtpUser        String?  @map("smtp_user") @db.VarChar(190)
  smtpPassEnc     Bytes?   @map("smtp_pass_enc") @db.VarBinary(512) // AES-256-GCM, §3.2
  smtpFromName    String?  @map("smtp_from_name") @db.VarChar(100)
  smtpFromEmail   String?  @map("smtp_from_email") @db.VarChar(190)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tenant_settings")
}

model User {
  id                 String    @id @db.Char(26)
  tenantId           String?   @map("tenant_id") @db.Char(26) // SUPER_ADMIN için NULL
  email              String    @unique @db.VarChar(190)
  username           String?   @unique @db.VarChar(60)
  fullName           String    @map("full_name") @db.VarChar(100)
  role               String    @db.VarChar(20) // SUPER_ADMIN | ADMIN | USER
  passwordHash       String    @map("password_hash") @db.VarChar(255) // argon2id
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count") // 1 sa pencere (G-23)
  failedWindowAt     DateTime? @map("failed_window_at") @db.DateTime(3)
  lockedUntil        DateTime? @map("locked_until") @db.DateTime(3) // yalnız hesap geneli kilit
  totpSecretEnc      Bytes?    @map("totp_secret_enc") @db.VarBinary(255) // AES-256-GCM (§3.2); setup'ta yazılır, enable'a kadar totp_enabled=false
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  totpLastStep       BigInt?   @map("totp_last_step") // P10: son kabul edilen TOTP adımı (floor(unix/30)); tekrar oynatma koruması (RFC 6238 §5.2)
  avatarPath         String?   @map("avatar_path") @db.VarChar(200)
  theme              String    @default("SYSTEM") @db.VarChar(20) // LIGHT | DARK | SYSTEM
  status             String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | PASSIVE
  version            Int       @default(0) @db.UnsignedInt // P14a (ADR-0023, AC-206): If-Match / ETag "v<n>"; her yönetim yazmasında +1 (koşullu UPDATE)
  deletedAt          DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions        UserPermission[]
  authSessions       AuthSession[]
  supportSessions    SupportSession[]     @relation("SessionTechnician")
  terminatedSessions SupportSession[]     @relation("SessionTerminator")
  consentTexts       ConsentText[]
  acceptedRequests   SupportRequest[]     @relation("RequestAcceptor")
  rejectedRequests   SupportRequest[]     @relation("RequestRejector")
  createdCustomers   Customer[]
  recoveryCodes      RecoveryCode[]
  passwordResets     PasswordResetToken[]
  systemSettings     SystemSetting[]
  requestBlocks      RequestBlock[]

  @@index([tenantId, status])
  @@map("users")
}

model UserPermission {
  userId    String   @map("user_id") @db.Char(26)
  permKey   String   @map("perm_key") @db.VarChar(60) // packages/contracts/src/permissions.ts
  granted   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, permKey])
  @@map("user_permissions")
}

// P10 (mimari §3.1, §5.1, AC-67): 10 tek kullanımlık TOTP kurtarma kodu. Düz kod DB'de yok (SHA-256 hex, normalize
// edilmiş koddan). Kullanım = koşullu UPDATE used_at (WHERE used_at IS NULL). Yeniden üretim / MFA sıfırlama = DELETE
// (kodlar gizli değerdir, geçmiş değeri yok; iz audit'te). Kullanıcı başına kod tekil (UQ(user_id, code_hash)).
model RecoveryCode {
  id        String    @id @db.Char(26)
  userId    String    @map("user_id") @db.Char(26)
  codeHash  String    @map("code_hash") @db.Char(64) // HMAC-SHA-256 hex (küçük harf); anahtar APP_ENCRYPTION_KEYS → HKDF (B-P10-7)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

// P10 (mimari §3.1, AC-66): e-posta ile şifre sıfırlama. Düz token yalnız e-postadaki linkte; DB'de SHA-256 hex.
// 30 dk (CHECK ≤ 31 dk), tek kullanım = koşullu UPDATE used_at. Yeni istek/şifre değişimi açık tokenları used_at ile
// kapatır. Retention (P13, §3.4): expires_at + 7 gün hard delete (DELETE yetkisi o pakette).
model PasswordResetToken {
  id        String    @id @db.Char(26)
  userId    String    @map("user_id") @db.Char(26)
  tokenHash String    @unique @map("token_hash") @db.Char(64) // SHA-256 hex; düz token DB'de yok
  expiresAt DateTime  @map("expires_at") @db.DateTime(3) // created_at + 30 dk
  usedAt    DateTime? @map("used_at") @db.DateTime(3) // kullanıldı veya geçersizleştirildi
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt]) // hesap başına istek sayımı + açık tokenları kapatma
  @@index([expiresAt]) // retention (§3.4)
  @@map("password_reset_tokens")
}

model AuthSession {
  id             String    @id @db.Char(26)
  userId         String    @map("user_id") @db.Char(26)
  tokenHash      String    @unique @map("token_hash") @db.Char(64) // SHA-256 hex; düz token DB'de yok
  actingTenantId String?   @map("acting_tenant_id") @db.Char(26) // Super Admin tenant geçişi
  ip             String    @db.VarChar(45)
  userAgent      String    @map("user_agent") @db.VarChar(300)
  lastSeenAt     DateTime  @map("last_seen_at") @db.DateTime(3)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3) // mutlak ≤ 8 sa
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  mfaPassed      Boolean   @default(false) @map("mfa_passed")
  stepUpAt       DateTime? @map("step_up_at") @db.DateTime(3) // P14a (ADR-0022, AC-215): son başarılı step-up anı (UTC); guard 5 dk
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actingTenant Tenant? @relation(fields: [actingTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt]) // retention: süresi dolan +7 gün silme (§3.4)
  @@map("auth_sessions")
}

// Append-only (G-15): app DB kullanıcısının bu tabloda UPDATE/DELETE yetkisi yok (prisma/sql/grants.sql; DELETE P13).
// P11 tetikleyicileri (migration.sql'de elle, migrator): audit_logs_no_update (her UPDATE → SIGNAL 45000) ve
// audit_logs_retention_only_delete (730 günden yeni satır DELETE → SIGNAL 45000; saat SYSDATE, SET TIMESTAMP etkilemez).
// user_id bilinçli olarak FK değil: başarısız girişte NULL/var olmayan kullanıcı olabilir,
// kayıt kullanıcıdan bağımsız kalıcıdır (username denormalize).
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  tenantId      String?  @map("tenant_id") @db.Char(26)
  userId        String?  @map("user_id") @db.Char(26)
  username      String?  @db.VarChar(190)
  action        String   @db.VarChar(60)
  entity        String   @db.VarChar(40)
  entityId      String?  @map("entity_id") @db.VarChar(40)
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  result        String   @db.VarChar(20) // success | fail
  correlationId String?  @map("correlation_id") @db.Char(26)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt]) // P11: (tenant_id, user_id, created_at) yerine — user_id ULID tenant'a özgü; Super Admin tüm-tenant kullanıcı filtresi
  @@index([tenantId, action, createdAt])
  @@index([action, createdAt]) // P11: Super Admin tüm-tenant işlem filtresi (audit ekranı, AC-76)
  @@index([tenantId, entity, entityId, createdAt]) // P8 oturum zaman çizelgesi (mimari-api "Oturum geçmişi" §3)
  @@index([createdAt]) // retention: 730 gün silme (§3.4)
  @@map("audit_logs")
}

// P2 (mimari §3.1, ADR-0006, G-02/G-22) + P3 (admit tüketimi: mode, consumed_at; zorla sonlandırma:
// terminated_by — A1, A5, G-04) + P5 (quality_summary — AC-46). Sonraki paket alanları (started_at,
// customer_*, ticket_no, note, anonymized_at) kendi migration'larında eklenir (expand). Hard delete yok; retention P13.
// CHECK kısıtları migration.sql'de (elle): status/ended_by enum, kod biçimleri,
// PENDING <=> active_code dolu, bitmiş durum <=> ended_at dolu, TTL 15..30 dk (+/-1 dk tolerans);
// P3: mode enum, consumed_at <=> mode, ACTIVE => consumed_at, PENDING/EXPIRED/CANCELLED => consumed_at NULL,
// consumed_at <= expires_at, ended_by='ADMIN' <=> terminated_by dolu (docs/db-notlari.md P3);
// P5: quality_summary JSON nesne, <= 4 KB, yalnız tüketilmiş (consumed_at dolu) oturumda.
model SupportSession {
  id             String    @id @db.Char(26)
  tenantId       String    @map("tenant_id") @db.Char(26)
  technicianId   String    @map("technician_id") @db.Char(26) // oluşturan teknisyen (users.id)
  tokenHash      String    @unique @map("token_hash") @db.Char(64) // SHA-256 hex; düz token DB'de yok (AC-2)
  activeCode     String?   @unique @map("active_code") @db.Char(8) // yalnız PENDING iken dolu; global tekil (AC-3)
  techVerifyCode String    @map("tech_verify_code") @db.Char(4) // müşterinin teknisyeni teyidi (G-01)
  status         String    @default("PENDING") @db.VarChar(20) // PENDING | ACTIVE | ENDED | EXPIRED | CANCELLED
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3) // created_at + tenant session_ttl_min
  endedAt        DateTime? @map("ended_at") @db.DateTime(3) // iptal/expiry/bitiş anı
  endedBy        String?   @map("ended_by") @db.VarChar(20) // TECH | CUSTOMER | ADMIN | SYSTEM
  endReason      String?   @map("end_reason") @db.VarChar(40) // ör. cancelled, expired
  mode           String?   @db.VarChar(20) // AGENT | BROWSER; admit anında set (A1/A2)
  consumedAt     DateTime? @map("consumed_at") @db.DateTime(3) // admit = tüketim = ACTIVE başlangıcı (AC-6/7/13)
  terminatedBy   String?   @map("terminated_by") @db.Char(26) // zorla sonlandıran Admin/Super Admin (G-04, AC-114)
  qualitySummary Json?     @map("quality_summary") // AC-46: quality.summary {fps,kbps,rttMs{avg,min,max},connType}
  customerName   String?   @map("customer_name") @db.VarChar(100) // P8: admit edilen misafirin adı (join customerName, trim'li 2..100); admit UPDATE'inde yazılır
  customerEmail  String?   @map("customer_email") @db.VarChar(254) // P8: misafir e-postası (opsiyonel); retention'da NULL (P13). P8b: 190→254 (talep e-postası AC-134 ≤ 254)
  ticketNo       String?   @map("ticket_no") @db.VarChar(50) // P8 AC-63: teknisyen girer; boş metin yerine NULL
  note           String?   @db.Text // P8 AC-63: ≤ 4000 karakter (CHECK)
  requestId      String?   @map("request_id") @db.Char(26) // P8b AC-158: talepten doğan oturum (NULL = teknisyen/kod yolu). Kaynak bundan türetilir
  guestNetKey    String?   @map("guest_net_key") @db.VarChar(64) // P8b §13.1: admit edilen misafirin ağ öneki (netKey: IPv4 /24, IPv6 /48); retention'da NULL
  guestIpKey     String?   @map("guest_ip_key") @db.VarChar(64) // P8b G-E9-15: misafirin tam ipKey'i (IPv4 /32, IPv6 /64) — "bilinen ağ" rozeti yalnız tam eşleşmede; retention'da NULL
  customerId     String?   @map("customer_id") @db.Char(26) // P8c AC-177/180: müşteri FİRMA (customers); customer_name misafir KİŞİdir. Kabul TX'inde talepten kopya veya POST /sessions customerId
  anonymizedAt   DateTime? @map("anonymized_at") @db.DateTime(3) // P13a AC-197: saklama işi kişisel alanları NULL'ladığı an (CHECK support_sessions_anonymized_chk)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  technician    User             @relation("SessionTechnician", fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  terminator    User?            @relation("SessionTerminator", fields: [terminatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request       SupportRequest?  @relation(fields: [requestId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  customer      Customer?        @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  consents      SessionConsent[]
  files         SessionFile[]
  bindingsFirst DeviceBinding[]  @relation("BindingFirstSession")
  bindingsLast  DeviceBinding[]  @relation("BindingLastSession")

  @@unique([id, tenantId]) // P4: session_consents/P5: session_files (session_id, tenant_id) bileşik FK hedefi (tenant tutarlılığı)
  @@unique([requestId, tenantId]) // P8b: talep başına en çok 1 oturum (request_id global tekil ULID → UQ(request_id) ile eşdeğer) + bileşik FK
  @@index([tenantId, createdAt]) // tenant geneli liste (P8) + tenant FK
  @@index([createdAt]) // P8 Super Admin tüm-tenant geçmiş listesi + P13 retention
  @@index([tenantId, status, createdAt]) // P8 geçmiş listesi durum filtresi (AC-60): eşitlik + created_at sırası/aralığı
  @@index([technicianId, status]) // AC-11 açık oturum sayımı + technician FK
  @@index([technicianId, createdAt]) // "kendi oturumlarım" listesi, AC-12 saatlik sayım
  @@index([status, expiresAt]) // expiry işi: status='PENDING' AND expires_at <= NOW(3); açılışta ACTIVE→ENDED
  @@index([terminatedBy]) // FK (RESTRICT kontrolü); MySQL'in gizli indeksi yerine adlı indeks
  @@index([tenantId, guestNetKey, consumedAt]) // P8b §13.1 bilinen ağ öneki (son 90 gün admit)
  @@index([tenantId, guestIpKey, consumedAt]) // P8b G-E9-15 tam IP eşleşmesi (son 90 gün admit)
  @@index([tenantId, anonymizedAt, createdAt]) // P13a retention aday sorgusu (tenant + anonymized_at IS NULL + created_at < cutoff)
  @@index([tenantId, customerId, createdAt]) // P8c geçmiş müşteri filtresi + müşteri detayı Oturumlar sekmesi + customer FK (tenant_id, customer_id)
  @@map("support_sessions")
}

// P4 (mimari §3.1, A1, AC-29/127, G-24): tenant bazlı, sürümlü KVKK aydınlatma/onay metni.
// Değişmez: yeni sürüm eklenir; app yalnız SELECT/INSERT (is_current geçişi için UPDATE(is_current) P11'de).
// Elle (migration.sql): sha256 = SHA2(body,256) CHECK, version >= 1, tenant başına tek is_current
// (fonksiyonel UQ consent_texts_one_current_uq — Prisma ifade edemez).
model ConsentText {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  version   Int
  body      String   @db.MediumText // API 50..20000 karakter; utf8mb4'te TEXT (64 KB) yetmeyebilir
  sha256    String   @db.Char(64) // SHA-256(UTF-8 body) küçük harf hex; DB CHECK ile body'ye bağlı
  isCurrent Boolean  @default(false) @map("is_current")
  createdBy String?  @map("created_by") @db.Char(26) // NULL = sistem/seed
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator  User?            @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consents SessionConsent[]
  requests SupportRequest[]

  @@unique([tenantId, version]) // + tenant FK; "güncel sürüm" araması bu indeksin ön ekiyle
  @@unique([id, tenantId, sha256]) // session_consents bileşik FK hedefi (AC-127: tenant + metin özeti tutarlı)
  @@index([createdBy])
  @@map("consent_texts")
}

// P4 (mimari §3.1, A1/A3/A4, AC-29/62/111): onay zaman çizelgesi. Append-only (updated_at yok, audit
// istisnası gibi); app yalnız SELECT/INSERT. Retention anonimleştirmesi (ip/user_agent NULL) P13'te UPDATE.
// Elle (migration.sql): level/decision/source CHECK; consent_text_id <=> consent_sha256.
model SessionConsent {
  id            String   @id @db.Char(26)
  sessionId     String   @map("session_id") @db.Char(26)
  tenantId      String   @map("tenant_id") @db.Char(26)
  level         String   @db.VarChar(20) // VIEW | CONTROL
  decision      String   @db.VarChar(20) // GRANTED | DENIED | REVOKED
  source        String   @db.VarChar(20) // UI | HOTKEY | RECONNECT | SYSTEM | TECH (P7, ADR-0013: teknisyen bırakması)
  consentTextId String?  @map("consent_text_id") @db.Char(26) // join anında onaylanan metin (A1)
  consentSha256 String?  @map("consent_sha256") @db.Char(64) // = consent_texts.sha256 (bileşik FK)
  ip            String?  @db.VarChar(45) // SYSTEM kaynağında yok; retention'da NULL
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  requestId     String?  @map("request_id") @db.Char(26) // P8b §13.3: talep oturumunun "Ekranımı paylaş" onayı → talep formundaki onaya bağ (kod yolunda NULL)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session     SupportSession  @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consentText ConsentText?    @relation(fields: [consentTextId, tenantId, consentSha256], references: [id, tenantId, sha256], onDelete: Restrict, onUpdate: Restrict)
  request     SupportRequest? @relation(fields: [requestId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionId, tenantId, createdAt]) // zaman çizelgesi (AC-62) + session FK
  @@index([tenantId, createdAt]) // tenant FK + retention
  @@index([consentTextId, tenantId, consentSha256]) // consent text FK
  @@index([requestId, tenantId]) // P8b request FK
  @@map("session_consents")
}

// P5 (mimari §3.1, mimari-protokol file.meta, AC-53/54/55): dosya transferi META kaydı. Dosya içeriği
// sunucudan geçmez ve SAKLANMAZ (AC-55). Append-only (updated_at yok); app yalnız SELECT/INSERT.
// Retention (P13): file_name anonimleştirme + hard delete — o pakette UPDATE/DELETE yetkisi ve file_name
// CHECK'inin anonim değere uyarlanması (db-notlari P5).
// Elle (migration.sql): direction/result enum, sha256 biçimi, size_bytes 0..2 GiB, file_name temizlenmiş
// biçim (sanitizeFileName çıktısı: 1..255 karakter, yasak karakter/Cf yok, sonda nokta/boşluk yok).
model SessionFile {
  id         String   @id @db.Char(26)
  sessionId  String   @map("session_id") @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  direction  String   @db.VarChar(20) // TO_CUSTOMER | TO_TECH
  fileName   String   @map("file_name") @db.VarChar(255) // sanitizeFileName sonrası ad (G-06)
  sizeBytes  BigInt   @map("size_bytes") // beyan/alınan bayt; <= tenant max_file_mb (üst sınır 2048 MB)
  sha256     String   @db.Char(64) // küçük harf hex (gönderenin beyanı; OK ise alıcı doğruladı)
  result     String   @db.VarChar(20) // OK | REJECTED | CANCELLED | CORRUPT
  // P15 (AC-238): raporlayan taraf (TECH | CUSTOMER; ikili CHECK, ADR-0014 — mimarideki ENUM yerine). Eski satırlar TECH.
  reportedBy String   @default("TECH") @map("reported_by") @db.VarChar(20)
  // P15: sunucunun ürettiği SHA-256 hex (aynı aktarımın iki taraf raporunu eşler); eski satırlarda NULL.
  matchKey   String?  @map("match_key") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session SupportSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sessionId, matchKey, reportedBy]) // P15: taraf başına aktarım başına tek rapor; eşleşme araması
  @@index([sessionId, tenantId, createdAt]) // oturum detayı dosya listesi (GET /sessions/:id) + session FK
  @@index([tenantId, createdAt]) // tenant FK + retention (P13)
  @@map("session_files")
}

// P8b-1 (mimari-e9 §3.1 + §13.6/13.8, AC-129..131, 142, 152): tenant başına talep ayarları (1-1, tembel oluşturulur).
// app SELECT/INSERT/UPDATE (DELETE yok). Elle (migration.sql): request_ref/file_label biçimi, wait_minutes 10..120,
// JSON dizileri JSON_SCHEMA_VALID (wa ≤ 5 E.164, email ≤ 5, trusted_cidrs ≤ 10; tekil), kanal açık ⇒ ≥ 1 alıcı.
model TenantRequestSettings {
  tenantId          String    @id @map("tenant_id") @db.Char(26)
  requestRef        String    @unique @map("request_ref") @db.Char(16) // [a-z2-7]{16} (80 bit); gizli değil, tahmin edilemez
  refRotatedAt      DateTime? @map("ref_rotated_at") @db.DateTime(3)
  fileLabel         String    @map("file_label") @db.VarChar(20) // [A-Za-z0-9]{1,20} — dosya adındaki firma kısa adı (AC-130)
  waitMinutes       Int       @default(30) @map("wait_minutes") // 10..120 (AC-142)
  waEnabled         Boolean   @default(false) @map("wa_enabled")
  waRecipients      Json      @map("wa_recipients") // string[] E.164, ≤ 5 (uygulama `[]` yazar; MySQL JSON varsayılanı Prisma'da yok)
  emailEnabled      Boolean   @default(false) @map("email_enabled") // P10'a kadar sunucu true'yu reddeder
  emailRecipients   Json      @map("email_recipients") // string[] e-posta, ≤ 5 (P10)
  trustedCidrs      Json      @map("trusted_cidrs") // string[] CIDR, ≤ 10 (§13.6; genişlik/özel aralık kuralı zod'da)
  requireAcceptCode Boolean   @default(false) @map("require_accept_code") // P15 (AC-239): kabulde 4 haneli kod
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tenant_request_settings")
}

// P8b-1 (mimari-e9 §3.2, §3.4, §13.1/13.3/13.8, G-E9-15; AC-134..160): müşteri destek talebi. Hard delete yok (P13).
// app SELECT/INSERT/UPDATE (anonimleştirme = UPDATE). Kişisel veri: customer_*, description, ip, ip_key, net_key,
// device_hash → anonimleştirmede NULL (anonymized_at). Elle (migration.sql) CHECK'ler: status/cancel_reason/network_match
// ikili enum (ADR-0014), biçimler (request_code, secret_hash, client_*, telefon, e-posta, device_hash), metin kuralları
// (ad/açıklama/ret mesajı), durum ↔ alan tutarlılığı (cancel_reason, closed_at, accepted_*, rejected_*, reject_message),
// PII ↔ anonymized_at, expires_at aralığı; fonksiyonel UQ: tenant içinde bekleyenlerde tekil request_code.
model SupportRequest {
  id             String    @id @db.Char(26)
  tenantId       String    @map("tenant_id") @db.Char(26)
  status         String    @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | CANCELLED | EXPIRED | REJECTED | CONNECT_FAILED
  cancelReason   String?   @map("cancel_reason") @db.VarChar(20) // CUSTOMER | DISCONNECTED | TENANT_PASSIVE | CUSTOMER_PASSIVE | BINDING_REVOKED (P8c; yalnız CANCELLED)
  requestCode    String    @map("request_code") @db.Char(6) // §13.1 gösterim kodu; tenant'ın bekleyenleri arasında tekil (fonksiyonel UQ)
  secretHash     String    @unique @map("secret_hash") @db.Char(64) // SHA-256(talep sırrı) hex; düz sır DB'de yok
  clientInstance String    @map("client_instance") @db.Char(22) // AC-143 örnek başına 1 bekleyen
  clientVersion  String    @map("client_version") @db.VarChar(20)
  customerName   String?   @map("customer_name") @db.VarChar(80)
  customerPhone  String?   @map("customer_phone") @db.VarChar(16) // E.164
  customerEmail  String?   @map("customer_email") @db.VarChar(254)
  description    String?   @db.VarChar(500) // tek satır (r2); audit'e yazılmaz
  consentTextId  String    @map("consent_text_id") @db.Char(26) // AC-135 onay kaydı: sürüm
  consentSha256  String    @map("consent_sha256") @db.Char(64)
  consentedAt    DateTime  @map("consented_at") @db.DateTime(3)
  ip             String?   @db.VarChar(45)
  ipKey          String?   @map("ip_key") @db.VarChar(64) // ipKey(): IPv4 /32, IPv6 /64 — IP başına bekleyen + tam IP eşleşmesi
  netKey         String?   @map("net_key") @db.VarChar(64) // netKey(): IPv4 /24, IPv6 /48 — önek başına bekleyen
  deviceHash     String?   @map("device_hash") @db.Char(64) // SHA-256(tenant_id ‖ deviceKey) hex
  networkMatch   String    @default("NONE") @map("network_match") @db.VarChar(20) // G-E9-15: NONE | PREFIX | IP | TRUSTED (dba sapma: known_network BOOL yerine)
  knownDevice    Boolean   @default(false) @map("known_device") // aynı device_hash son 90 günde oturuma bağlanmış (G-E9-17)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3) // created_at + wait_minutes
  acceptedBy     String?   @map("accepted_by") @db.Char(26)
  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  rejectedBy     String?   @map("rejected_by") @db.Char(26)
  rejectMessage  String?   @map("reject_message") @db.VarChar(200)
  closedAt       DateTime? @map("closed_at") @db.DateTime(3) // PENDING dışındaki her durumda dolu
  anonymizedAt   DateTime? @map("anonymized_at") @db.DateTime(3)
  customerId     String?   @map("customer_id") @db.Char(26) // P8c AC-175/176: NULL = Genel (Genel ref veya Genel kayıt)
  bindingId      String?   @map("binding_id") @db.Char(26) // P8c: kayıtla açılan talep (API viaBinding/bindingRevoked bundan türer)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consentText ConsentText      @relation(fields: [consentTextId, tenantId, consentSha256], references: [id, tenantId, sha256], onDelete: Restrict, onUpdate: Restrict)
  acceptor    User?            @relation("RequestAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rejector    User?            @relation("RequestRejector", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer    Customer?        @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  binding     DeviceBinding?   @relation(fields: [bindingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  session     SupportSession?
  consents    SessionConsent[]

  @@unique([id, tenantId]) // support_sessions/session_consents (request_id, tenant_id) bileşik FK hedefi
  @@index([tenantId, status, createdAt]) // kuyruk (asc) + sıra hesabı + pasif tenant süpürücüsü + tenant FK
  @@index([tenantId, closedAt]) // geçmiş sekmesi: son 30 gün closed_at DESC (dba ek)
  @@index([status, expiresAt]) // süpürücü: PENDING süre dolumu, ACCEPTED 60 sn
  @@index([tenantId, ipKey, status]) // IP başına bekleyen (≤ 3)
  @@index([tenantId, netKey, status]) // önek başına bekleyen (≤ 10)
  @@index([tenantId, clientInstance, status]) // örnek başına bekleyen (1)
  @@index([tenantId, deviceHash]) // known_device hesabı
  @@index([tenantId, anonymizedAt, createdAt]) // anonimleştirme işi (tenant retention_days) — IX(created_at) yerine (dba sapma)
  @@index([consentTextId, tenantId, consentSha256]) // consent text FK
  @@index([acceptedBy]) // FK
  @@index([rejectedBy]) // FK
  @@index([tenantId, customerId, createdAt]) // P8c müşteri detayı Talepler sekmesi, türetilmiş sayaçlar (COUNT/MAX), filtre + customer FK (tenant_id, customer_id)
  @@index([bindingId, tenantId, status]) // P8c kayıt başına 1 bekleyen + ADMIN_REVOKED bekleyenleri kapatma + binding FK
  @@map("support_requests")
}

// P8c-1 (mimari-e10 §3.1, §3.7, §15; AC-165..173, 195): tenant'ın müşteri firmaları. Hard delete YOK (pasif + PII
// anonimleştirme). app SELECT/INSERT/UPDATE. name_key/search_key utf8mb4_bin (elle ALTER; Prisma sütun harmanlaması
// ifade edemez) — değerleri servis contracts foldKey ile her yazımda hesaplar. Elle (migration.sql) CHECK'ler: ad/etiket/
// ref/telefon/e-posta/kişi/not biçimleri, status ikili enum, PASSIVE ⇔ passive_at, anonimleşmiş ⇒ PII NULL,
// search_key name_key ile başlar.
// Bileşik FK hedefi UQ(tenant_id, id) (mimarideki (id, tenant_id) sırası tersine çevrildi — db-notlari P8c karar 1).
model Customer {
  id           String    @id @db.Char(26)
  tenantId     String    @map("tenant_id") @db.Char(26)
  name         String    @db.VarChar(100) // 2..100 kod noktası, kırpılmış, Cc/Cf/Zl/Zp yok
  nameKey      String    @map("name_key") @db.VarChar(200) // foldKey(name); UQ(tenant_id, name_key) pasifler dahil (AC-167)
  searchKey    String    @map("search_key") @db.VarChar(400) // foldKey(name) + ' ' + foldKey(contact) + ' ' + rakamlar(phone)
  fileLabel    String    @map("file_label") @db.VarChar(20) // [A-Za-z0-9]{1,20}; tekil değil
  requestRef   String    @unique @map("request_ref") @db.Char(16) // [a-z2-7]{16}; her zaman dolu, request_refs'e kayıtlı
  refRotatedAt DateTime? @map("ref_rotated_at") @db.DateTime(3) // son yenileme / yeniden aktif etme (G-E10-1 bayat kaynak)
  contactName  String?   @map("contact_name") @db.VarChar(80) // kişisel (AC-195)
  phone        String?   @db.VarChar(16) // E.164, kişisel
  email        String?   @db.VarChar(254) // kişisel
  note         String?   @db.VarChar(1000) // düz metin; yalnız \n serbest; kişisel sayılır
  status       String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | PASSIVE
  passiveAt    DateTime? @map("passive_at") @db.DateTime(3)
  anonymizedAt DateTime? @map("anonymized_at") @db.DateTime(3) // doluyken PII NULL (CHECK); PII yazan UPDATE bunu NULL'lamalı
  createdBy    String?   @map("created_by") @db.Char(26)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         User?            @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestRefs     RequestRef[]
  deviceBindings  DeviceBinding[]
  supportRequests SupportRequest[]
  supportSessions SupportSession[]

  @@unique([tenantId, nameKey]) // ad tekilliği (pasifler dahil) + liste name_key sırası (status filtresiz)
  @@unique([tenantId, id]) // bileşik FK hedefi (request_refs, device_bindings, support_requests, support_sessions)
  @@index([tenantId, status, nameKey]) // liste (durum filtresi + varsayılan ad sırası), options
  @@index([tenantId, createdAt]) // createdAt:desc sırası
  @@index([status, passiveAt]) // anonimleştirme işi (pasif + retention)
  @@index([createdBy]) // FK
  @@map("customers")
}

// P8c-1 (mimari-e10 §3.2, ADR-0006 r5; AC-168): tek ref ad alanı — Genel + müşteri ref'leri, emekliler dahil. APPEND-ONLY:
// app yalnız SELECT/INSERT (updated_at yok, audit_logs kalıbı). Satır asla silinmez/güncellenmez → bir ref iki kez verilmez.
// Çözümleme bu tablodan yapılmaz (güncel ref sahibin sütunundadır). Elle: ref biçim CHECK. Migration geri doldurma:
// tenant_request_settings.request_ref (idempotent INSERT … SELECT … WHERE NOT EXISTS).
// FK sırası: müşteri ref'inde ÖNCE customers INSERT, SONRA request_refs INSERT (FK anında denetlenir).
model RequestRef {
  ref        String   @id @db.Char(16) // [a-z2-7]{16}
  tenantId   String   @map("tenant_id") @db.Char(26)
  customerId String?  @map("customer_id") @db.Char(26) // NULL = Genel
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, customerId]) // customer FK (tenant_id, customer_id) + tenant FK + tenant/müşteri ref geçmişi
  @@map("request_refs")
}

// P8c-1 (mimari-e10 §3.3, §15.3; ADR-0017; AC-181..187, 195): bilgisayar kaydı. Anahtar yalnız SHA-256 hex (key_hash);
// geçersizleşince key_hash NULL, satır audit için kalır. Kişisel veri yok. app SELECT/INSERT/UPDATE (DELETE P13).
// active_session_id: STORED üretilmiş sütun IF(revoked_at IS NULL, last_session_id, NULL) + UQ → oturum başına en çok
// bir etkin kayıt (G-E10-3). Sütun migration.sql'de elle üretilmiş yapılır — UYGULAMA BU ALANA ASLA YAZMAZ (MySQL 3105);
// yalnız okuma/filtre. Elle CHECK'ler: revoked_at ⇔ key_hash NULL ⇔ revoke_reason, revoke_reason ikili enum, key_hash/
// client_version biçimi, issue_count ≥ 1.
model DeviceBinding {
  id              String    @id @db.Char(26)
  tenantId        String    @map("tenant_id") @db.Char(26)
  customerId      String?   @map("customer_id") @db.Char(26) // NULL = Genel kayıt
  keyHash         String?   @unique @map("key_hash") @db.Char(64) // SHA-256 hex(rsb_… tam dize); geçersizde NULL
  clientVersion   String    @map("client_version") @db.VarChar(20)
  firstSessionId  String    @map("first_session_id") @db.Char(26)
  lastSessionId   String    @map("last_session_id") @db.Char(26)
  issueCount      Int       @default(1) @map("issue_count")
  lastUsedAt      DateTime  @map("last_used_at") @db.DateTime(3) // verme/yenileme + kayıtla başarılı talep (K21)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  revokeReason    String?   @map("revoke_reason") @db.VarChar(20) // FORGOTTEN|REPLACED|CUSTOMER_ROTATED|CUSTOMER_PASSIVE|GENERAL_ROTATED|TENANT_PASSIVE|EXPIRED|ADMIN_REVOKED
  activeSessionId String?   @unique @map("active_session_id") @db.Char(26) // STORED üretilmiş (elle) — YAZMAYIN
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer     Customer?        @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  firstSession SupportSession   @relation("BindingFirstSession", fields: [firstSessionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  lastSession  SupportSession   @relation("BindingLastSession", fields: [lastSessionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  requests     SupportRequest[]

  @@unique([id, tenantId]) // support_requests (binding_id, tenant_id) bileşik FK hedefi
  @@index([tenantId, customerId, revokedAt]) // müşteri/Genel toplu geçersizleştirme + customer FK (tenant_id, customer_id)
  @@index([revokedAt, lastUsedAt]) // boşta kalma işi (EXPIRED) + pasif tenant süpürücüsü
  @@index([lastSessionId, tenantId]) // FK
  @@index([firstSessionId, tenantId]) // FK
  @@map("device_bindings")
}

// P11 (mimari §3.1, §3.2; AC-77, 78): sistem düzeyi ayarlar (yalnız Super Admin). Anahtar başına tek satır; satır yoksa
// varsayılan/env kullanılır. Gizli değer yalnız secret_enc'te (AES-256-GCM, lib/crypto.ts) — value_json'a ASLA yazılmaz.
// Elle CHECK'ler (migration.sql): key kümesi (ikili, ADR-0014) `mysql` | `turn`; value_json nesne ≤ 4 KB + anahtar başına
// JSON şeması; secret_enc 30..512 bayt; turn: turn:/turns: URL'si varken secret zorunlu. app SELECT/INSERT/UPDATE (DELETE yok).
model SystemSetting {
  key       String   @id @db.VarChar(60) // mysql | turn
  valueJson Json?    @map("value_json") // mysql: {host, port, database, user}; turn: {urls: string[]}
  secretEnc Bytes?   @map("secret_enc") @db.VarBinary(512) // mysql: şifre; turn: static-auth-secret
  updatedBy String?  @map("updated_by") @db.Char(26) // son değiştiren Super Admin (iz audit'te)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedBy]) // FK
  @@map("system_settings")
}

// P15 (mimari-e11 §6; AC-235): talep engelleri (IP/önek ya da cihaz anahtarı). app SELECT/INSERT/DELETE (UPDATE yok →
// updated_at yok; süre değişimi = DELETE + INSERT). Tenant başına ≤ 1.000 (uygulama). Elle CHECK'ler: kind ikili enum,
// kind ⇔ hedef sütunlar, IP 4/16 bayt gerçek CIDR bloğu (IPv4 ≤ /24, IPv6 ≤ /48), device_key_hash hex, expires_at >
// created_at, note metin kuralı. Ayrıntı db-notlari "P15".
model RequestBlock {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  kind          String    @db.VarChar(20) // IP | DEVICE
  ipFrom        Bytes?    @map("ip_from") @db.VarBinary(16) // ağ adresi (4 ya da 16 bayt)
  ipTo          Bytes?    @map("ip_to") @db.VarBinary(16) // yayın adresi (aynı uzunluk)
  deviceKeyHash String?   @map("device_key_hash") @db.Char(64) // SHA-256 hex, küçük harf
  expiresAt     DateTime? @map("expires_at") @db.DateTime(3) // NULL = süresiz
  note          String?   @db.VarChar(200)
  createdBy     String    @map("created_by") @db.Char(26)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, ipFrom, ipTo]) // aynı aralık tek satır
  @@unique([tenantId, deviceKeyHash]) // aynı cihaz tek satır
  @@index([tenantId, kind, expiresAt]) // kapı önbelleği yüklemesi + liste
  @@index([createdBy]) // FK
  @@map("request_blocks")
}
