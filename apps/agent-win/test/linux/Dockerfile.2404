# P28g K8a (mimari-p28g §8.2 test-linux-gui, §9; S-P28g-9 "test imajları taban digest'iyle sabit"): Ubuntu 24.04 GUI test imajı.
# Yalnız CI/yerel test içindir; ürün imajı değildir, hiçbir yere itilmez. Kullanım: test/linux/gui.sh 2404 (docs/runbook.md §28g).
# İçerik: Xvfb (X11 katmanı), başsız mutter + xdg-desktop-portal(-gnome) + pipewire (Wayland katmanı), GTK3, GStreamer
# base/good + pipewire (ürünün beyaz listesindeki öğeler; ugly/bad/libav BİLEREK YOK — T6), libX11/libXi/libXtst, D-Bus,
# cups-client, xdg-user-dirs, TR yerel; XI2 ofset karşılaştırması için gcc + libxi-dev (D-P28g-T2-2) + libgtk-3-dev/pkg-config (K10 GdkEvent, D-P28g-K2-4); strace (ortam pozitif
# kontrolü, §14 m.2). Go araç zinciri agent-win.yml GO_IMAGE'dan gelir (tek sürüm kaynağı; gui.sh --build-arg ile verir).
# apt paket sürümleri sabit değildir (taban digest sabit); test sonucu değişirse önce imaj paket listesine bakın.
ARG GO_IMAGE
FROM ${GO_IMAGE} AS go

FROM ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git locales language-pack-tr procps psmisc file binutils strace \
    xvfb xauth x11-utils x11-xserver-utils libx11-6 libxi6 libxtst6 \
    libgtk-3-0 libgtk-3-bin adwaita-icon-theme yaru-theme-gtk dconf-gsettings-backend gsettings-desktop-schemas \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-pipewire pipewire pipewire-bin wireplumber libpulse0 pipewire-pulse \
    dbus mutter xwayland xdg-desktop-portal xdg-desktop-portal-gnome \
    xdg-user-dirs cups-client \
    gcc libc6-dev libxi-dev libgtk-3-dev pkg-config \
  && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0 LANG=C.UTF-8
