{
  "name": "remote-support",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:generate": "pnpm --filter @remote/server db:generate",
    "db:migrate": "pnpm --filter @remote/server db:migrate",
    "db:seed": "pnpm --filter @remote/server db:seed",
    "docs:pdf": "bash scripts/build-docs.sh"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
